BACKUP ~IWDEE-Portraits/backup~
AUTHOR ~Sauler89 / community project~
VERSION ~v0.1.0-beta4~

README ~IWDEE-Portraits/README.md~

LANGUAGE ~English~ ~english~ ~IWDEE-Portraits/tra/english.tra~

BEGIN ~IWDEE Portraits - Main Collection (357 portraits)~
DESIGNATED 0
REQUIRE_PREDICATE GAME_IS ~iwdee~ @1000
COPY ~IWDEE-Portraits/data/main~ ~override~
INCLUDE ~IWDEE-Portraits/data/register_main.tpa~

BEGIN ~IWDEE Portraits - Baldur's Gate Characters (36 portraits)~
DESIGNATED 10
REQUIRE_PREDICATE GAME_IS ~iwdee~ @1000
COPY ~IWDEE-Portraits/data/bg~ ~override~
INCLUDE ~IWDEE-Portraits/data/register_bg.tpa~

BEGIN ~IWDEE Portraits - Planescape: Torment Characters (24 portraits)~
DESIGNATED 20
REQUIRE_PREDICATE GAME_IS ~iwdee~ @1000
COPY ~IWDEE-Portraits/data/pst~ ~override~
INCLUDE ~IWDEE-Portraits/data/register_pst.tpa~

BEGIN ~IWDEE Portraits - Icewind Dale II Portraits (24 portraits)~
DESIGNATED 30
REQUIRE_PREDICATE GAME_IS ~iwdee~ @1000
COPY ~IWDEE-Portraits/data/iwd2~ ~override~

ACTION_IF NOT (RESOURCE_CONTAINS ~UI.MENU~ ~rgGetGameEnginePortraits~) BEGIN
  COPY ~IWDEE-Portraits/data/m_iwp_iwd2.lua~ ~override/m_iwp_iwd2.lua~
END

BEGIN ~IWDEE Portraits - Garion's Portrait Pack (122 portraits, zoomed sidebar)~
DESIGNATED 40
REQUIRE_PREDICATE GAME_IS ~iwdee~ @1000
COPY ~IWDEE-Portraits/data/garion~ ~override~
INCLUDE ~IWDEE-Portraits/data/register_garion.tpa~

BEGIN ~IWDEE Portraits - Zoomed Vanilla Sidebar Portraits (59 replacements)~
DESIGNATED 100
REQUIRE_PREDICATE GAME_IS ~iwdee~ @1000
COPY ~IWDEE-Portraits/data/vanilla_zoomed~ ~override~

BEGIN ~IWDEE Portraits - Photoshopped Variations (10 portraits, zoomed sidebar)~
DESIGNATED 200
REQUIRE_PREDICATE GAME_IS ~iwdee~ @1000
COPY ~IWDEE-Portraits/data/photoshopped~ ~override~
INCLUDE ~IWDEE-Portraits/data/register_photoshopped.tpa~
